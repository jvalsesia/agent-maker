DATABASE_URL=postgres://agentmaker:agentmaker@127.0.0.1:5432/agentmaker
BIND_ADDR=127.0.0.1:8787
RUST_LOG=agent_maker=info,tower_http=info,sqlx=warn
AGENT_MAKER_HOME=~/.agent-maker
# Set to 1 to skip the OS keychain probe and always use the encrypted file store.
# Recommended on Linux desktops where Secret Service is unreliable.
# AGENT_MAKER_FORCE_FILE_STORE=1

# --- F10: Access and Identity (FusionAuth) ---
# RUST_ENV controls dev-only behavior. Set to "development" to enable DISABLE_AUTH.
RUST_ENV=development

# DISABLE_AUTH bypasses the auth middleware and injects a fake admin context.
# ONLY honored when RUST_ENV=development. Use during inner-loop work to skip
# paying FusionAuth's ~30-60s JVM boot.
DISABLE_AUTH=1

# FusionAuth connection. Defaults below match the bundled docker-compose
# fusionauth service and the committed kickstart.json.
FUSIONAUTH_BASE_URL=http://127.0.0.1:9011
FUSIONAUTH_TENANT_ID=00000000-0000-0000-0000-000000003efa
FUSIONAUTH_APPLICATION_ID=00000000-0000-0000-0000-0000000a9911
FUSIONAUTH_CLIENT_ID=00000000-0000-0000-0000-0000000a9911
FUSIONAUTH_CLIENT_SECRET=agent-maker-local-dev-secret-do-not-use-in-prod
FUSIONAUTH_API_KEY=agent-maker-local-dev-api-key-do-not-use-in-prod

# Cookie configuration. Leave AUTH_COOKIE_DOMAIN empty for localhost.
# AUTH_COOKIE_SECURE must be true in production (https); false for local http.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

# Local kickstart admin (do not use these credentials in production):
#   email:    admin@agent-maker.local
#   password: ChangeMeNow!1
