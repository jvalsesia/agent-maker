DATABASE_URL=postgres://agentmaker:agentmaker@127.0.0.1:5432/agentmaker
BIND_ADDR=127.0.0.1:8787
RUST_LOG=agent_maker=info,tower_http=info,sqlx=warn
AGENT_MAKER_HOME=~/.agent-maker
