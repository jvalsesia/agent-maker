DATABASE_URL=postgres://agentmaker:agentmaker@127.0.0.1:5432/agentmaker
BIND_ADDR=127.0.0.1:8787
RUST_LOG=agent_maker=info,tower_http=info,sqlx=warn
AGENT_MAKER_HOME=~/.agent-maker
# Set to 1 to skip the OS keychain probe and always use the encrypted file store.
# Recommended on Linux desktops where Secret Service is unreliable.
# AGENT_MAKER_FORCE_FILE_STORE=1

# --- Authentication (F10, Clerk) ---
# Auth is ENFORCED only when BOTH CLERK_JWKS_URL and CLERK_ISSUER are set.
# With both unset, the backend runs in disabled (pass-through) mode for local dev
# and tests. Setting exactly one fails fast at startup.
# CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
# Optional: allow a cross-origin frontend (CORS). Same-origin dev (Vite proxy)
# and prod (nginx/fallback) need no value.
# CORS_ALLOWED_ORIGIN=https://app.example.com

# Frontend (build-time, Vite): the client mounts Clerk only when this is present.
# Absent → the login wall is disabled on the client.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
